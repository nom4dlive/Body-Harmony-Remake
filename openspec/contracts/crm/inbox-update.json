{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Inbox Name Update Contract",
  "description": "Atualização rápida do nome da caixa de entrada/canal no Chatwoot via Portal do Gestor (PLAN-164)",
  "type": "object",
  "endpoints": {
    "update": {
      "method": "PATCH",
      "path": "/api/v1/crm/inboxes/{inboxId}",
      "auth_required": true,
      "roles": ["admin", "superadmin"],
      "request": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Novo nome amigável do canal ou caixa de entrada"
          }
        },
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["success", "error"]
          },
          "data": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
