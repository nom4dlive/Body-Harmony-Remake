{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Cockpit Context Contract",
  "description": "Especificação do contrato de consulta de contexto 360º para a barra lateral do Chatwoot (PLAN-174)",
  "type": "object",
  "endpoints": {
    "get_context": {
      "method": "GET",
      "path": "/api/v1/crm/cockpit/context",
      "auth_required": false,
      "request": {
        "type": "object",
        "required": ["phone"],
        "properties": {
          "phone": {
            "type": "string"
          },
          "conversation_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "response": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["success", "error"]
          },
          "data": {
            "type": "object",
            "required": ["profile_type", "contact", "appointments", "quick_links"],
            "properties": {
              "profile_type": {
                "type": "string",
                "enum": ["NOVO_PACIENTE", "PACIENTE_RECORRENTE", "LICENCIADA", "LEAD_COMERCIAL"]
              },
              "contact": {
                "type": "object",
                "required": ["name", "phone_formatted"],
                "properties": {
                  "name": { "type": "string" },
                  "phone_raw": { "type": "string" },
                  "phone_formatted": { "type": "string" },
                  "cpf": { "type": ["string", "null"] },
                  "cidade": { "type": ["string", "null"] },
                  "uf": { "type": ["string", "null"] },
                  "drive_folder_url": { "type": ["string", "null"] }
                }
              },
              "appointments": {
                "type": "array"
              },
              "recent_actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "description": { "type": "string" },
                    "timestamp": { "type": "string" }
                  }
                }
              },
              "quick_links": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
