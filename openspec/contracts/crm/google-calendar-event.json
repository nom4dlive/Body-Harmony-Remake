{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Google Calendar Event Contract",
  "description": "Especificação do contrato de criação e sincronização de agendamentos no Google Calendar com Google Meet (PLAN-177)",
  "type": "object",
  "endpoints": {
    "create": {
      "method": "POST",
      "path": "/api/v1/crm/google/calendar/events",
      "auth_required": true,
      "request": {
        "type": "object",
        "required": ["patient_name", "start_time", "end_time"],
        "properties": {
          "calendar_id": { "type": "string" },
          "patient_name": { "type": "string" },
          "patient_phone": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "start_time": { "type": "string" },
          "end_time": { "type": "string" },
          "create_meet": { "type": "boolean" }
        }
      },
      "response": {
        "type": "object",
        "required": ["success", "event_id", "html_link"],
        "properties": {
          "success": { "type": "boolean" },
          "event_id": { "type": "string" },
          "html_link": { "type": "string" },
          "meet_link": { "type": "string" },
          "created_at": { "type": "string" }
        }
      }
    }
  }
}
