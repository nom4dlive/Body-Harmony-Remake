{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Canned Responses Seed Contract",
  "description": "Especificação do contrato de seed e gestão de macros de respostas rápidas no Chatwoot (PLAN-176)",
  "type": "object",
  "endpoints": {
    "seed": {
      "method": "POST",
      "path": "/api/v1/crm/canned-responses/seed",
      "auth_required": true,
      "request": {
        "type": "object",
        "properties": {
          "overwrite": { "type": "boolean" }
        }
      },
      "response": {
        "type": "object",
        "required": ["success", "synced_count", "macros"],
        "properties": {
          "success": { "type": "boolean" },
          "synced_count": { "type": "integer" },
          "macros": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["short_code", "content"],
              "properties": {
                "short_code": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          },
          "message": { "type": "string" }
        }
      }
    }
  }
}
