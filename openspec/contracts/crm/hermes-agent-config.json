{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HermesAgentConfigContract",
  "description": "Contrato de configuração e modos operacionais do Hermes Agent CRM (Nexus V3.1 - PLAN-179)",
  "type": "object",
  "properties": {
    "juridico_mode": {
      "type": "string",
      "enum": ["MUTED", "COPILOT", "AUTO"]
    },
    "licenciadas_mode": {
      "type": "string",
      "enum": ["MUTED", "COPILOT", "AUTO"]
    },
    "clinica_mode": {
      "type": "string",
      "enum": ["MUTED", "COPILOT", "AUTO"]
    },
    "comercial_mode": {
      "type": "string",
      "enum": ["MUTED", "COPILOT", "HYBRID_24_7", "AUTO"]
    },
    "qwen_endpoint": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    }
  },
  "required": ["juridico_mode", "licenciadas_mode", "clinica_mode", "comercial_mode", "is_active"]
}
