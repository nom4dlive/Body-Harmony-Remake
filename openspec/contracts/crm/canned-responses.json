{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrmCannedResponsesContract",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "synced_count": { "type": "integer" },
    "macros": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "short_code": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["short_code", "content"]
      }
    }
  },
  "required": ["success", "synced_count"]
}
