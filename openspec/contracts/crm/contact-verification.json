{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRM Contact Verification Contract",
  "type": "object",
  "required": ["instance_key", "phone"],
  "properties": {
    "instance_key": { "type": "string" },
    "phone": { "type": "string" },
