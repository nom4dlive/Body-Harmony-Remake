{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleOAuthFlowContract",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "auth_url": { "type": "string" },
    "client_id": { "type": "string" },
    "redirect_uri": { "type": "string" },
    "scopes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "is_configured": { "type": "boolean" },
    "has_token": { "type": "boolean" },
    "account": { "type": "string" },
    "message": { "type": "string" }
  },
  "required": ["success"]
}
