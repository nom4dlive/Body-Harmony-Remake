{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleOAuthStatusContract",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "is_connected": { "type": "boolean" },
    "is_live_api": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["LIVE_GOOGLE_API", "LOCAL_FALLBACK"] },
    "account": { "type": "string" },
    "auth_type": { "type": "string", "enum": ["service_account", "oauth2_token", "none"] },
    "scopes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "services": {
      "type": "object",
      "properties": {
        "contacts": { "type": "string", "enum": ["active", "error", "standby"] },
        "calendar": { "type": "string", "enum": ["active", "error", "standby"] },
        "drive": { "type": "string", "enum": ["active", "error", "standby"] },
        "meet": { "type": "string", "enum": ["active", "error", "standby"] }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "token_file_found": { "type": "boolean" },
        "service_account_found": { "type": "boolean" },
        "has_refresh_token": { "type": "boolean" },
        "token_expired": { "type": "boolean" },
        "last_probe_timestamp": { "type": "string" }
      }
    },
    "synced_contacts_count": { "type": "integer" },
    "token_expires_in": { "type": "integer" }
  },
  "required": ["success", "is_connected", "account"]
}
