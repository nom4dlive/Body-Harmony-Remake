{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShopGetProductsContract",
  "description": "Contrato da lista de produtos da vitrine da loja com todas as features e persistência garantida",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tagline": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "long_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_cents": {
            "type": "integer"
          },
          "payment_link_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stock_limit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "is_active": {
            "type": "integer"
          },
          "sort_order": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "price_cents",
          "category",
          "is_active",
          "features"
        ]
      }
    }
  },
  "required": [
    "success",
    "data"
  ]
}