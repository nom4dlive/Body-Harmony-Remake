{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoneWebhookContract",
  "description": "Contrato de webhook recebido da Stone Payments API",
  "type": "object",
  "properties": {
    "event_type": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "initiator_id": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "integer" }
      },
      "required": ["id", "initiator_id", "status"]
    }
  },
  "required": ["event_type", "data"]
}
