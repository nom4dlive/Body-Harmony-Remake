{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinancialTransactionsListContract",
  "description": "Contrato de listagem paginada de transacoes financeiras com filtros por status, data, categoria e tag tributaria.",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 1, "default": 1 },
        "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "refunded", "cancelled"] },
        "type": { "type": "string", "enum": ["revenue", "refund", "chargeback", "expense"] },
        "source_type": { "type": "string", "enum": ["shop_order", "onboarding", "licenciamento", "manual", "subscription"] },
        "tax_tag": { "type": "string", "enum": ["estetica_cosmetica", "servicos_medicos_educacionais", "nao_definido"] },
        "category": { "type": "string" },
        "event_tag": { "type": "string" },
        "date_from": { "type": "string", "format": "date" },
        "date_to": { "type": "string", "format": "date" },
        "search": { "type": "string" },
        "sort": { "type": "string", "enum": ["created_at", "amount_cents"], "default": "created_at" },
        "order": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
      }
    },
    "response": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "data": {
          "type": "object",
          "properties": {
            "transactions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer" },
                  "source_type": { "type": "string" },
                  "source_id": { "type": ["integer", "null"] },
                  "type": { "type": "string" },
                  "amount_cents": { "type": "integer" },
                  "amount_formatted": { "type": "string" },
                  "currency": { "type": "string" },
                  "description": { "type": ["string", "null"] },
                  "category": { "type": ["string", "null"] },
                  "tax_tag": { "type": "string" },
                  "event_tag": { "type": ["string", "null"] },
                  "payment_method": { "type": ["string", "null"] },
                  "installments": { "type": "integer" },
                  "status": { "type": "string" },
                  "confirmed_at": { "type": ["string", "null"] },
                  "created_at": { "type": "string" }
                }
              }
            },
            "pagination": {
              "type": "object",
              "properties": {
                "total": { "type": "integer" },
                "page": { "type": "integer" },
                "per_page": { "type": "integer" },
                "total_pages": { "type": "integer" }
              }
            }
          },
          "required": ["transactions", "pagination"]
        }
      },
      "required": ["success", "data"]
    }
  }
}
