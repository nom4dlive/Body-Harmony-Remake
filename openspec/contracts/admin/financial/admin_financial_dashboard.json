{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinancialDashboardContract",
  "description": "Contrato do Dashboard Financeiro consolidado do Portal do Gestor Body Harmony. Retorna KPIs executivos: Margem de Lucro, CAC, Cash Runway, Inadimplencia, Receita Mensal e resumo de transacoes.",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "data": {
      "type": "object",
      "properties": {
        "revenue": {
          "type": "object",
          "properties": {
            "total_cents": { "type": "integer" },
            "total_formatted": { "type": "string" },
            "period_label": { "type": "string" },
            "vs_last_period_pct": { "type": ["number", "null"] }
          },
          "required": ["total_cents", "total_formatted", "period_label"]
        },
        "margin": {
          "type": "object",
          "properties": {
            "gross_pct": { "type": "number" },
            "net_pct": { "type": "number" },
            "status": { "type": "string", "enum": ["healthy", "warning", "critical"] }
          },
          "required": ["gross_pct", "net_pct", "status"]
        },
        "cash_runway": {
          "type": "object",
          "properties": {
            "months_remaining": { "type": "number" },
            "current_balance_cents": { "type": "integer" },
            "avg_monthly_cost_cents": { "type": "integer" },
            "status": { "type": "string", "enum": ["healthy", "warning", "critical"] }
          },
          "required": ["months_remaining", "current_balance_cents", "avg_monthly_cost_cents", "status"]
        },
        "cac": {
          "type": "object",
          "properties": {
            "value_cents": { "type": "integer" },
            "formatted": { "type": "string" },
            "marketing_spend_cents": { "type": "integer" },
            "new_customers": { "type": "integer" }
          },
          "required": ["value_cents", "formatted", "marketing_spend_cents", "new_customers"]
        },
        "inadimplencia": {
          "type": "object",
          "properties": {
            "pending_count": { "type": "integer" },
            "pending_total_cents": { "type": "integer" },
            "pending_formatted": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "integer" },
                  "source_type": { "type": "string" },
                  "customer_name": { "type": "string" },
                  "amount_cents": { "type": "integer" },
                  "days_overdue": { "type": "integer" },
                  "status": { "type": "string" }
                }
              }
            }
          },
          "required": ["pending_count", "pending_total_cents", "pending_formatted"]
        },
        "recent_transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "type": { "type": "string" },
              "amount_cents": { "type": "integer" },
              "amount_formatted": { "type": "string" },
              "description": { "type": ["string", "null"] },
              "category": { "type": ["string", "null"] },
              "source_type": { "type": "string" },
              "status": { "type": "string" },
              "created_at": { "type": "string" }
            }
          }
        },
        "monthly_revenue_chart": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "month": { "type": "string" },
              "revenue_cents": { "type": "integer" },
              "expenses_cents": { "type": "integer" },
              "net_cents": { "type": "integer" }
            }
          }
        }
      },
      "required": ["revenue", "margin", "cash_runway", "cac", "inadimplencia"]
    }
  },
  "required": ["success", "data"]
}
