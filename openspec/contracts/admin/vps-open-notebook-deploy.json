{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VpsOpenNotebookDeployContract",
  "type": "object",
  "description": "Contrato de execução e validação do deploy do Open Notebook e QwenProxy na VPS 2.25.156.25",
  "properties": {
    "vps_target": {
      "type": "string",
      "default": "2.25.156.25"
    },
    "remote_path": {
      "type": "string",
      "default": "/opt/open-notebook"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "qwen-proxy",
        "surrealdb",
        "open_notebook"
      ]
    },
    "health_endpoints": {
      "type": "object",
      "properties": {
        "qwen_proxy": {
          "type": "string",
          "default": "http://127.0.0.1:4000/v1/models"
        },
        "fastapi": {
          "type": "string",
          "default": "http://127.0.0.1:5055/health"
        },
        "web_ui": {
          "type": "string",
          "default": "http://127.0.0.1:8502"
        }
      }
    }
  }
}