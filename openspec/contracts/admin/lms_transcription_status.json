{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LMSTranscriptionStatusContract",
  "description": "Contrato de consulta de status de transcrição de aula para o Portal do Gestor",
  "type": "object",
  "required": [
    "lesson_id",
    "transcription_status"
  ],
  "properties": {
    "lesson_id": {
      "type": "integer",
      "description": "ID numérico da aula"
    },
    "transcription_status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]
    },
    "transcription_job_id": {
      "type": ["string", "null"]
    },
    "transcription_error": {
      "type": ["string", "null"]
    },
    "transcription_completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_id": {
      "type": ["string", "null"],
      "description": "ID do registro de fonte no SurrealDB se completado"
    }
  }
}
