{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContractsListContract",
  "description": "Contrato de listagem, busca e contadores do gerenciador de contratos no painel Admin",
  "endpoints": {
    "/v1/admin/contracts": {
      "GET": {
        "summary": "Obtém listagem paginada de contratos com contadores de status e filtros",
        "security": ["AdminToken"],
        "parameters": [
          { "name": "status", "in": "query", "type": "string", "enum": ["ALL", "DRAFT", "GENERATED", "PENDING_SIGNATURE", "SIGNED", "CANCELLED"] },
          { "name": "search", "in": "query", "type": "string", "description": "Busca por nome da licenciada, documento ou título" },
          { "name": "page", "in": "query", "type": "integer", "default": 1 },
          { "name": "limit", "in": "query", "type": "integer", "default": 20 }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "counters": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "pending_signature": { "type": "integer" },
                        "signed_month": { "type": "integer" },
                        "draft": { "type": "integer" }
                      },
                      "required": ["total", "pending_signature", "signed_month", "draft"]
                    },
                    "contracts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "uuid": { "type": "string" },
                          "title": { "type": "string" },
                          "template_slug": { "type": "string" },
                          "licenciada_id": { "type": ["integer", "null"] },
                          "licenciada_name": { "type": "string" },
                          "licenciada_document": { "type": "string" },
                          "licenciada_location": { "type": "string" },
                          "status": { "type": "string", "enum": ["DRAFT", "GENERATED", "PENDING_SIGNATURE", "SIGNED", "CANCELLED", "ARCHIVED"] },
                          "sha256_hash": { "type": ["string", "null"] },
                          "has_pdf": { "type": "boolean" },
                          "sign_token": { "type": ["string", "null"] },
                          "sign_url": { "type": ["string", "null"] },
                          "signed_at": { "type": ["string", "null"], "format": "date-time" },
                          "created_at": { "type": "string", "format": "date-time" },
                          "updated_at": { "type": "string", "format": "date-time" }
                        },
                        "required": ["id", "uuid", "title", "licenciada_name", "status", "created_at"]
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "total_pages": { "type": "integer" },
                        "total_records": { "type": "integer" }
                      },
                      "required": ["page", "limit", "total_pages", "total_records"]
                    }
                  },
                  "required": ["ok", "counters", "contracts", "pagination"]
                }
              }
            }
          },
          "401": { "description": "Não autorizado" }
        }
      }
    }
  }
}
