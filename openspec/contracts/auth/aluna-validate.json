{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/auth/aluna/validate — Contrato V3.1 (PLAN-010)",
  "description": "Valida o token de sessão de uma aluna e retorna os dados básicas da sessão, incluindo CPF como identificador primário.",
  "request": {
    "method": "GET",
    "path": "/api/v1/auth/aluna/validate",
    "headers": {
      "X-ALUNA-TOKEN": "string (obrigatório, formato: al_<hex>)"
    }
  },
  "response": {
    "success": {
      "status": 200,
      "body": {
        "success": true,
        "valid": true,
        "aluna": {
          "id": "integer",
          "name": "string",
          "email": "string | null",
          "cpf": "string (11 dígitos numéricos) | null",
          "force_password_change": "boolean"
        }
      }
    },
    "error_401": {
      "status": 401,
      "body": {
        "success": false,
        "message": "Sessão inválida ou expirada."
      }
    }
  },
  "plan_ref": "PLAN-010",
  "updated_at": "2026-06-05"
}
