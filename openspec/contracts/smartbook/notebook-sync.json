{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartBookNotebookSyncContract",
  "description": "Contrato de API para sincronização e vinculação de fontes do LMS/MySQL com os cadernos no SurrealDB pelo Gestor",
  "endpoint": {
    "method": "POST",
    "path": "/api/v1/smartbook/sync/notebook",
    "roles_allowed": ["GESTOR"]
  },
  "request": {
    "type": "object",
    "required": ["lms_module_id", "title"],
    "properties": {
      "lms_module_id": {
        "type": "integer",
        "description": "ID numérico do módulo oficial do LMS MySQL"
      },
      "title": {
        "type": "string",
        "description": "Título oficial do módulo/caderno"
      },
      "description": {
        "type": "string",
        "description": "Ementa ou descrição dos protocolos do módulo"
      },
      "lessons": {
        "type": "array",
        "description": "Lista de aulas/fontes associadas ao módulo no LMS",
        "items": {
          "type": "object",
          "required": ["lesson_id", "title", "source_type"],
          "properties": {
            "lesson_id": { "type": "integer" },
            "title": { "type": "string" },
            "source_type": { "type": "string", "enum": ["video", "audio", "pdf", "text"] },
            "file_path": { "type": "string" },
            "transcription_text": { "type": "string" }
          }
        }
      }
    }
  },
  "response": {
    "type": "object",
    "required": ["success", "surreal_notebook_id", "sources_synced"],
    "properties": {
      "success": { "type": "boolean" },
      "lms_module_id": { "type": "integer" },
      "surreal_notebook_id": {
        "type": "string",
        "description": "ID gerado no SurrealDB (ex: notebook:mod_01)"
      },
      "sources_synced": {
        "type": "integer",
        "description": "Total de fontes criadas/vinculadas ao grafo"
      },
      "synced_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
