{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NotebookAuthTicketContract",
  "type": "object",
  "description": "Emissão de ticket JWT efêmero para carregar o IA Notebook na Área da Licenciada/Aluna",
  "request": {
    "type": "object",
    "required": [
      "module_id"
    ],
    "properties": {
      "module_id": {
        "type": "integer",
        "description": "ID do módulo do LMS que a aluna está estudando"
      }
    }
  },
  "response": {
    "type": "object",
    "required": [
      "success",
      "embed_url",
      "ticket",
      "expires_in"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "embed_url": {
        "type": "string",
        "description": "URL completa para o iframe do IA Notebook"
      },
      "ticket": {
        "type": "string",
        "description": "JWT efêmero assinado"
      },
      "expires_in": {
        "type": "integer",
        "description": "Tempo de expiração em segundos (ex: 3600)"
      }
    }
  }
}