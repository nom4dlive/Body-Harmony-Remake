{
  "name": "body-harmony-monolith",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "unimported": {
    "entry": [
      "src/main.jsx"
    ],
    "ignorePatterns": [
      "**/node_modules/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/tests/**",
      "**/vitest.config.js"
    ],
    "ignoreUnresolved": [],
    "ignoreUnimported": [],
    "ignoreUnused": []
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "build:hostinger": "node ../../scripts/devops/build-release.js",
    "build:release": "node ../../scripts/devops/build-release.js",
    "lint": "eslint .",
    "deploy": "powershell -ExecutionPolicy Bypass -File ../../Operations/deploy-pro.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.26.2",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.17.2",
    "quill": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.4.0",
    "react-player": "^3.4.0",
    "react-quill-new": "^3.7.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.7.0",
    "styled-components": "^6.1.13",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^28.1.0",
    "unimported": "^1.31.0",
    "vite": "^6.0.5",
    "vitest": "^4.0.18"
  }
}
