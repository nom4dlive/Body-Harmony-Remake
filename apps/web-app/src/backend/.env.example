# Body Harmony - Production Environment Variables

# Database Configuration (Required)
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# API Keys (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Setup Script Passwords (Required for setup_auto.php)
# These are used ONLY during initial system setup
# Users will change passwords after first login
DEFAULT_STUDENT_PASSWORD=change_me_strong_password
ADMIN_JOSI_PASSWORD=change_me_strong_admin_password

# Superadmin Credentials (Required for initial setup)
SUPERADMIN_USER=your_superadmin_username
SUPERADMIN_PASS=your_superadmin_password

# System Configuration
SETUP_DONE=false
SITE_URL=https://bodyharmony.com.br

# Optional: FTP Credentials (for deployment scripts)
# FTP_HOST=
# FTP_USER=
# FTP_PASS=
