# ==============================================================================
# Body Harmony Nexus V3.1 — CRM Stack Environment Variables (.env.crm)
# Dedicated VPS (2.25.156.25)
# ==============================================================================

# --- [ PostgreSQL 16 ] ---
POSTGRES_USER=bodyharmony_crm
POSTGRES_PASSWORD=bh_crm_postgres_secure_2026!
POSTGRES_DB=postgres

# --- [ Redis 7 ] ---
REDIS_PASSWORD=bh_crm_redis_secure_2026!

# --- [ Evolution API v2 ] ---
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=https://evolution.bodyharmony.com.br
EVOLUTION_API_KEY=bh_evo_global_key_v31_2026_secure
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Database Persistence for Evolution
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://bodyharmony_crm:bh_crm_postgres_secure_2026!@crm-postgres:5432/evolution_v2
DATABASE_CONNECTION_CLIENT_NAME=evolution_v2
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# Cache for Evolution (Redis DB 1)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:bh_crm_redis_secure_2026!@crm-redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution_v2
CACHE_REDIS_SAVE_INSTANCES=true

# Evolution Native Chatwoot Integration
CHATWOOT_ENABLED=true

# --- [ Chatwoot v3 ] ---
CHATWOOT_PORT=3000
FRONTEND_URL=https://crm.bodyharmony.com.br
SECRET_KEY_BASE=bh_chatwoot_secret_key_base_v31_super_secure_random_hash_2026_prod!
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=false
ENABLE_TELEMETRY=false

# Chatwoot Database (PostgreSQL DB 0)
POSTGRES_HOST=crm-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=bodyharmony_crm
POSTGRES_PASSWORD=bh_crm_postgres_secure_2026!

# Chatwoot Redis (Redis DB 0)
REDIS_URL=redis://:bh_crm_redis_secure_2026!@crm-redis:6379/0
REDIS_PASSWORD=bh_crm_redis_secure_2026!

# Email / SMTP Configuration
MAILER_SENDER_EMAIL=suporte@bodyharmony.com.br
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=suporte@bodyharmony.com.br
SMTP_PASSWORD=SuaSenhaAqui*
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# === Asaas Gateway de Pagamentos ===
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_ENVIRONMENT=production
ASAAS_DISABLE_NOTIFICATIONS=false
ASAAS_WEBHOOK_TOKEN=your_webhook_secret_token_here
